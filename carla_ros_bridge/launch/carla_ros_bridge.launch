<!-- -->
<launch>
  <!-- global parameter to set CARLA as time source -->
  <arg name='use_sim_time' default='True'/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- the network connection for the python connection to CARLA -->
  <arg name='host' default='carla-server'/>
  <arg name='port' default='2000'/>
  <arg name='timeout' default='5000'/>
  <!-- 
    enable/disable synchronous mode. If enabled ros-bridge waits until
    expected data is received for all sensors
  -->
  <arg name="passive" default='False'/>
  <arg name='synchronous_mode' default='True'/>
  <arg name='synchronous_mode_wait_for_vehicle_control_command' default='False'/>
  <!-- set the fixed timestep length -->
  <arg name='fixed_delta_seconds' default='0.05'/>
  <arg name='start_unix_time_stamp' default='0'/>
  <arg name='town' default=''/>
  <arg name='rt_factor' default='1.0'/>
  <!-- enable/disable the registration of all sensors. If disabled, only sensors
  spawned by the bridge are registered -->
  <arg name='register_all_sensors' default='True'/>
  <!-- enable CARLA native DDS interfaces (skips sensor publishers and control subscribers) -->
  <arg name='native_interface' default='True'/>
  <!-- 
    the role name of the vehicles that acts as ego vehicle for this ros bridge instance
    Only the vehicles within this list are controllable from within ROS.
    (the vehicle from CARLA is selected which has the attribute 'role_name' set to this value)
  -->
  <arg name='ego_vehicle_role_name' default='["hero", "ego_vehicle", "hero0", "hero1", "hero2", "hero3"]'/>
  
  <!-- enable/disable object list with static vehicles -->
  <arg name='publish_static_vehicles' default='True'/>

  <!-- Enable/disable compressed image publishing -->
  <arg name='publish_compressed_images' default='True'/>

  <!-- disable altitude information -->
  <arg name='ignore_altitude' default='True'/>
  <!-- georeference substitution -->
  <arg name='georeference_substitution' default=''/>
  <!-- enable/disable grid convergence -->
  <arg name='grid_convergence' default='None'/>
      
  <!-- traffic light etsi messages-->
  <arg name='publish_etsi_messages' default='False'/>
  <arg name='waypoints_search_distance' default='1.0'/>
  <arg name='lane_waypoints_count' default='10'/>
  <arg name='traffic_light_junction_max_search_count' default='13'/>
  <arg name='debug_traffic_light_information' default='False'/>
  <arg name='integrate_junctions_without_traffic_lights' default='False'/>
  <arg name='traffic_light_junction_search_ignored_ids' default='[-1]'/>
  <arg name='publisher_mapem_timer_period' default='1.0'/>
  <arg name='publisher_spatem_timer_period' default='0.1'/>
  <arg name='publisher_debug_traffic_light_information_timer_period' default='1.0'/>

  <node pkg="carla_ros_bridge" name="carla_ros_bridge" type="bridge.py" output="screen" required="true">
    <param name="host" value="$(arg host)"/>
    <param name="port" value="$(arg port)"/>
    <param name="timeout" value="$(arg timeout)"/>
    <param name="passive" value="$(arg passive)"/>
    <param name="synchronous_mode" value="$(arg synchronous_mode)"/>
    <param name="synchronous_mode_wait_for_vehicle_control_command" value="$(arg synchronous_mode_wait_for_vehicle_control_command)"/>
    <param name="fixed_delta_seconds" value="$(arg fixed_delta_seconds)"/>
    <param name="start_unix_time_stamp" value="$(arg start_unix_time_stamp)"/>
    <param name="register_all_sensors" value="$(arg register_all_sensors)"/>
    <param name="native_interface" value="$(arg native_interface)"/>
    <param name="town" value="$(arg town)"/>
    <param name="ego_vehicle_role_name" value="$(arg ego_vehicle_role_name)"/>
    <param name="rt_factor" value="$(arg rt_factor)"/>
    <param name='publish_static_vehicles' value='$(arg publish_static_vehicles)'/>
    <param name='publish_compressed_images' value='$(arg publish_compressed_images)'/>
    <param name='ignore_altitude' value='$(arg ignore_altitude)'/>
    <param name='georeference_substitution' value='$(arg georeference_substitution)'/>
    <param name='grid_convergence' value='$(arg grid_convergence)'/>
    <param name='publish_etsi_messages' value='$(arg publish_etsi_messages)'/>
    <param name='publisher_mapem_timer_period' value='$(arg publisher_mapem_timer_period)'/>
    <param name='publisher_spatem_timer_period' value='$(arg publisher_spatem_timer_period)'/>
    <param name='integrate_junctions_without_traffic_lights' value='$(arg integrate_junctions_without_traffic_lights)'/>
    <param name='traffic_light_junction_search_ignored_ids' value='$(arg traffic_light_junction_search_ignored_ids)'/>
    <param name='traffic_light_junction_max_search_count' value='$(arg traffic_light_junction_max_search_count)'/>
    <param name='waypoints_search_distance' value='$(arg waypoints_search_distance)'/>
    <param name='lane_waypoints_count' value='$(arg lane_waypoints_count)'/>
    <param name='debug_traffic_light_information' value='$(arg debug_traffic_light_information)'/>
    <param name='publisher_debug_traffic_light_information_timer_period' value='$(arg publisher_debug_traffic_light_information_timer_period)'/>
  </node>
</launch>
